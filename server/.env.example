# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (Neon) ---
# Get from Neon dashboard. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=10

# --- CORS ---
CLIENT_ORIGIN="http://localhost:5173"

# --- First Super Admin (used only by seed script) ---
SUPER_ADMIN_EMAIL="admin@example.edu"
SUPER_ADMIN_PASSWORD="ChangeMe!Now123"
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_STAFF_ID="SA-0001"

# --- QR / signing ---
# Signs attendance + venue QR tokens. Falls back to JWT_SECRET when unset, but
# set it separately so rotating JWT_SECRET doesn't invalidate printed QR codes.
QR_SIGNING_SECRET="replace-with-a-long-random-string"

# --- Email (optional) ---
# Leave blank to disable email. The app degrades gracefully: password-reset and
# notification emails are skipped, in-app notifications still work.
# For Gmail use an App Password (Google Account -> Security -> App Passwords).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Examinations <noreply@example.edu>"
