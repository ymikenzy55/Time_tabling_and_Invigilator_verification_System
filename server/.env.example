# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (Neon) ---
# Get from Neon dashboard. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=10

# --- CORS ---
CLIENT_ORIGIN="http://localhost:5173"

# --- First Super Admin (used only by seed script) ---
SUPER_ADMIN_EMAIL="admin@example.edu"
SUPER_ADMIN_PASSWORD="ChangeMe!Now123"
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_STAFF_ID="SA-0001"

# --- QR / signing ---
# Signs attendance + venue QR tokens. Falls back to JWT_SECRET when unset, but
# set it separately so rotating JWT_SECRET doesn't invalidate printed QR codes.
QR_SIGNING_SECRET="replace-with-a-long-random-string"

# --- Email (optional) ---
# Leave blank to disable email. The app degrades gracefully: password-reset and
# notification emails are skipped, in-app notifications still work.

# Option 1: Brevo (recommended for production - 300 free emails/day)
# Get API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""                      # Your Brevo API key
BREVO_SMTP_USER=""                    # Your Brevo SMTP login email

# Option 2: Generic SMTP (Gmail, Outlook, etc.)
# For Gmail use an App Password (Google Account -> Security -> App Passwords).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Examinations <noreply@example.edu>"

# --- SMS Providers (optional) ---
# Pick ANY ONE that works for you - system will use whichever is configured
# All Ghana providers cost ~GH₵0.05/SMS (~$0.003)

# Hubtel (Ghana - MOST RELIABLE, 20+ years established)
# Get credentials from https://hubtel.com/
HUBTEL_CLIENT_ID=""                   # Your Hubtel Client ID
HUBTEL_CLIENT_SECRET=""               # Your Hubtel Client Secret
HUBTEL_SENDER_ID="UENR"               # Your sender ID

# mNotify (Ghana - Good reputation)
# Get API key from https://www.mnotify.com/
MNOTIFY_API_KEY=""                    # Your mNotify API key
MNOTIFY_SENDER_ID="UENR"              # Your sender ID

# Arkesel (Ghana - Affordable)
# Get API key from https://arkesel.com/
ARKESEL_API_KEY=""                    # Your Arkesel API key
ARKESEL_SENDER_ID="UENR"              # Your sender ID

# Vokryn (1000 FREE SMS/month - if signup works)
# Get API key from https://vokryn.com/
VOKRYN_API_KEY=""                     # Your Vokryn API key
VOKRYN_SENDER_ID="UENR"               # Optional sender ID

# Twilio (International - $15 free trial credit)
# Get credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""  # E.164 format: +15551234567

# Africa's Talking (African markets)
# Get credentials from https://account.africastalking.com/
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# Termii (West Africa)
# Get credentials from https://termii.com/
TERMII_API_KEY=""
TERMII_SENDER_ID=""
