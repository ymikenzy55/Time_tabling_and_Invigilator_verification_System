generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        String     @id @default(cuid())
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  semesters Semester[]
}

model Attendance {
  id             String           @id @default(cuid())
  invigilationId String
  userId         String?
  result         AttendanceResult
  scannedAt      DateTime         @default(now())
  ipAddress      String?
  userAgent      String?
  notes          String?
  invigilation   Invigilation     @relation(fields: [invigilationId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])

  @@index([invigilationId])
  @@index([invigilationId, userId])
  @@index([scannedAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  result     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([action])
  @@index([actorId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model Course {
  id                             String         @id @default(cuid())
  code                           String
  title                          String
  departmentId                   String
  level                          Int
  semesterId                     String
  creditHours                    Int
  studentCount                   Int            @default(0)
  examDurationMinutes            Int            @default(120)
  specialRequirements            String?
  status                         CourseStatus   @default(DRAFT)
  rejectionComment               String?
  locked                         Boolean        @default(false)
  createdById                    String?
  approvedById                   String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime       @default(now()) @updatedAt
  submittedAt                    DateTime?
  approvedAt                     DateTime?
  instructorName                 String?
  isPractical                    Boolean        @default(false)
  approvedBy                     User?          @relation("Course_approvedByIdToUser", fields: [approvedById], references: [id])
  createdBy                      User?          @relation("Course_createdByIdToUser", fields: [createdById], references: [id])
  department                     Department     @relation(fields: [departmentId], references: [id])
  semester                       Semester       @relation(fields: [semesterId], references: [id])
  invigilations                  Invigilation[]

  @@unique([code, semesterId])
  @@index([createdById, status])
  @@index([createdById, updatedAt])
  @@index([departmentId, semesterId])
  @@index([level])
  @@index([semesterId, status])
  @@index([status])
  @@index([status, semesterId])
}

model CourseLevel {
  id           String     @id @default(cuid())
  value        Int
  label        String?
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, value])
  @@index([departmentId, value])
}

model Department {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  courses     Course[]
  courseLevels CourseLevel[]
  users       User[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email])
  @@index([expiresAt])
}

model ExaminationSession {
  id              String            @id @default(cuid())
  name            String
  semesterId      String
  startDate       DateTime
  endDate         DateTime
  isPublished     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  semester        Semester          @relation(fields: [semesterId], references: [id])
  invigilations   Invigilation[]
  venueAssignments VenueAssignment[]
  venueScans      VenueScan[]
}

model Invigilation {
  id                                    String             @id @default(cuid())
  examinationSessionId                  String
  courseId                              String
  invigilatorId                         String?
  replacementId                         String?
  isActive                              Boolean            @default(true)
  scheduledAt                           DateTime
  windowOpensAt                         DateTime?
  windowClosesAt                        DateTime?
  gracePeriodMin                        Int                @default(0)
  createdAt                             DateTime           @default(now())
  updatedAt                             DateTime           @default(now()) @updatedAt
  venueId                               String?
  splitRange                            String?
  attendance                            Attendance[]
  course                                Course             @relation(fields: [courseId], references: [id])
  examinationSession                    ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  invigilator                           User?              @relation("Invigilation_invigilatorIdToUser", fields: [invigilatorId], references: [id])
  replacement                           User?              @relation("Invigilation_replacementIdToUser", fields: [replacementId], references: [id])
  venue                                 Venue?             @relation(fields: [venueId], references: [id])

  @@index([courseId])
  @@index([examinationSessionId, scheduledAt])
  @@index([examinationSessionId, venueId, scheduledAt])
  @@index([invigilatorId])
  @@index([invigilatorId, scheduledAt])
  @@index([replacementId])
  @@index([venueId, scheduledAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model RegistrationWindow {
  role        Role     @id
  opensAt     DateTime
  closesAt    DateTime
  updatedAt   DateTime   @default(now()) @updatedAt
  updatedById String?

  @@index([opensAt, closesAt])
}

model Semester {
  id                 String               @id @default(cuid())
  name               String
  academicYearId     String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean              @default(false)
  courses            Course[]
  examinationSessions ExaminationSession[]
  academicYear       AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id                                            String            @id @default(cuid())
  email                                         String            @unique
  passwordHash                                  String?
  fullName                                      String
  staffId                                       String?           @unique
  phone                                         String?
  role                                          Role
  status                                        UserStatus        @default(PENDING_APPROVAL)
  departmentId                                  String?
  createdAt                                     DateTime          @default(now())
  updatedAt                                     DateTime          @default(now()) @updatedAt
  approvedAt                                    DateTime?
  approvedById                                  String?
  departmentName                                String?
  createdById                                   String?
  isDemo                                        Boolean           @default(false)
  attendance                                    Attendance[]
  auditLogs                                     AuditLog[]
  approvedCourses                               Course[]          @relation("Course_approvedByIdToUser")
  createdCourses                                Course[]          @relation("Course_createdByIdToUser")
  invigilations                                 Invigilation[]    @relation("Invigilation_invigilatorIdToUser")
  replacements                                  Invigilation[]    @relation("Invigilation_replacementIdToUser")
  notifications                                 Notification[]
  passwordResets                                PasswordReset[]
  createdBy                                     User?             @relation("UserToUser", fields: [createdById], references: [id])
  createdUsers                                  User[]            @relation("UserToUser")
  department                                    Department?       @relation(fields: [departmentId], references: [id])
  venueAssignments                              VenueAssignment[]
  venueScans                                    VenueScan[]

  @@index([departmentId])
  @@index([email])
  @@index([role])
  @@index([role, status])
  @@index([status])
}

model Venue {
  id              String            @id @default(cuid())
  name            String            @unique
  capacity        Int
  location        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now()) @updatedAt
  invigilations    Invigilation[]
  venueAssignments VenueAssignment[]
  venueScans       VenueScan[]

  @@index([isActive])
}

model VenueAssignment {
  id                   String             @id @default(cuid())
  examinationSessionId String
  venueId              String
  invigilatorId        String
  slotAt               DateTime
  createdAt            DateTime           @default(now())
  examinationSession   ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  invigilator          User               @relation(fields: [invigilatorId], references: [id], onDelete: Cascade)
  venue                Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([examinationSessionId, venueId, slotAt, invigilatorId])
  @@index([examinationSessionId, venueId])
  @@index([examinationSessionId, venueId, slotAt])
  @@index([invigilatorId, examinationSessionId, slotAt])
  @@index([invigilatorId, slotAt])
}

model VenueScan {
  id                   String             @id @default(cuid())
  venueId              String
  examinationSessionId String
  userId               String
  result               AttendanceResult
  scannedAt            DateTime           @default(now())
  ipAddress            String?
  userAgent            String?
  latitude             Float?
  locationAccuracy     Float?
  longitude            Float?
  locationAddress      String?
  examinationSession   ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue                Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([examinationSessionId, venueId])
  @@index([examinationSessionId, venueId, scannedAt])
  @@index([userId, scannedAt])
  @@index([venueId, scannedAt])
}

enum AttendanceResult {
  RECORDED
  REJECTED_WINDOW
  REJECTED_DUPLICATE
  REJECTED_UNASSIGNED
  REJECTED_INVALID_QR
  REJECTED_VENUE_MISMATCH
  ABSENT
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  DEPARTMENT_HEAD
  INVIGILATOR
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DISABLED
  REJECTED
}
