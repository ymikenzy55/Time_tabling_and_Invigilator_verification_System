generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AcademicYear {
  id        String     @id
  name      String     @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(false)
  Semester  Semester[]
}

model Attendance {
  id             String           @id
  invigilationId String
  userId         String?
  result         AttendanceResult
  scannedAt      DateTime         @default(now())
  ipAddress      String?
  userAgent      String?
  notes          String?
  Invigilation   Invigilation     @relation(fields: [invigilationId], references: [id], onDelete: Cascade)
  User           User?            @relation(fields: [userId], references: [id])

  @@index([invigilationId])
  @@index([invigilationId, userId])
  @@index([scannedAt])
  @@index([userId])
}

model AuditLog {
  id         String   @id
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  result     String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [actorId], references: [id])

  @@index([action])
  @@index([actorId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model Course {
  id                             String         @id
  code                           String
  title                          String
  departmentId                   String
  level                          Int
  semesterId                     String
  creditHours                    Int
  studentCount                   Int            @default(0)
  examDurationMinutes            Int            @default(120)
  specialRequirements            String?
  status                         CourseStatus   @default(DRAFT)
  rejectionComment               String?
  locked                         Boolean        @default(false)
  createdById                    String?
  approvedById                   String?
  createdAt                      DateTime       @default(now())
  updatedAt                      DateTime
  submittedAt                    DateTime?
  approvedAt                     DateTime?
  instructorName                 String?
  isPractical                    Boolean        @default(false)
  User_Course_approvedByIdToUser User?          @relation("Course_approvedByIdToUser", fields: [approvedById], references: [id])
  User_Course_createdByIdToUser  User?          @relation("Course_createdByIdToUser", fields: [createdById], references: [id])
  Department                     Department     @relation(fields: [departmentId], references: [id])
  Semester                       Semester       @relation(fields: [semesterId], references: [id])
  Invigilation                   Invigilation[]

  @@unique([code, semesterId])
  @@index([createdById, status])
  @@index([createdById, updatedAt])
  @@index([departmentId, semesterId])
  @@index([level])
  @@index([semesterId, status])
  @@index([status])
  @@index([status, semesterId])
}

model CourseLevel {
  id           String     @id
  value        Int
  label        String?
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, value])
  @@index([departmentId, value])
}

model Department {
  id          String        @id
  name        String
  code        String        @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Course      Course[]
  CourseLevel CourseLevel[]
  User        User[]
}

model EmailVerification {
  id        String   @id
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email])
  @@index([expiresAt])
}

model ExaminationSession {
  id              String            @id
  name            String
  semesterId      String
  startDate       DateTime
  endDate         DateTime
  isPublished     Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Semester        Semester          @relation(fields: [semesterId], references: [id])
  Invigilation    Invigilation[]
  VenueAssignment VenueAssignment[]
  VenueScan       VenueScan[]
}

model Invigilation {
  id                                    String             @id
  examinationSessionId                  String
  courseId                              String
  invigilatorId                         String?
  replacementId                         String?
  isActive                              Boolean            @default(true)
  scheduledAt                           DateTime
  windowOpensAt                         DateTime?
  windowClosesAt                        DateTime?
  gracePeriodMin                        Int                @default(0)
  createdAt                             DateTime           @default(now())
  updatedAt                             DateTime
  venueId                               String?
  splitRange                            String?
  Attendance                            Attendance[]
  Course                                Course             @relation(fields: [courseId], references: [id])
  ExaminationSession                    ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  User_Invigilation_invigilatorIdToUser User?              @relation("Invigilation_invigilatorIdToUser", fields: [invigilatorId], references: [id])
  User_Invigilation_replacementIdToUser User?              @relation("Invigilation_replacementIdToUser", fields: [replacementId], references: [id])
  Venue                                 Venue?             @relation(fields: [venueId], references: [id])

  @@index([courseId])
  @@index([examinationSessionId, scheduledAt])
  @@index([examinationSessionId, venueId, scheduledAt])
  @@index([invigilatorId])
  @@index([invigilatorId, scheduledAt])
  @@index([replacementId])
  @@index([venueId, scheduledAt])
}

model Notification {
  id        String   @id
  userId    String
  type      String
  title     String
  message   String
  link      String?
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model PasswordReset {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model RegistrationWindow {
  role        Role     @id
  opensAt     DateTime
  closesAt    DateTime
  updatedAt   DateTime
  updatedById String?

  @@index([opensAt, closesAt])
}

model Semester {
  id                 String               @id
  name               String
  academicYearId     String
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean              @default(false)
  Course             Course[]
  ExaminationSession ExaminationSession[]
  AcademicYear       AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime
}

model User {
  id                                            String            @id
  email                                         String            @unique
  passwordHash                                  String?
  fullName                                      String
  staffId                                       String?           @unique
  phone                                         String?
  role                                          Role
  status                                        UserStatus        @default(PENDING_APPROVAL)
  departmentId                                  String?
  createdAt                                     DateTime          @default(now())
  updatedAt                                     DateTime
  approvedAt                                    DateTime?
  approvedById                                  String?
  departmentName                                String?
  createdById                                   String?
  isDemo                                        Boolean           @default(false)
  Attendance                                    Attendance[]
  AuditLog                                      AuditLog[]
  Course_Course_approvedByIdToUser              Course[]          @relation("Course_approvedByIdToUser")
  Course_Course_createdByIdToUser               Course[]          @relation("Course_createdByIdToUser")
  Invigilation_Invigilation_invigilatorIdToUser Invigilation[]    @relation("Invigilation_invigilatorIdToUser")
  Invigilation_Invigilation_replacementIdToUser Invigilation[]    @relation("Invigilation_replacementIdToUser")
  Notification                                  Notification[]
  PasswordReset                                 PasswordReset[]
  User                                          User?             @relation("UserToUser", fields: [createdById], references: [id])
  other_User                                    User[]            @relation("UserToUser")
  Department                                    Department?       @relation(fields: [departmentId], references: [id])
  VenueAssignment                               VenueAssignment[]
  VenueScan                                     VenueScan[]

  @@index([departmentId])
  @@index([email])
  @@index([role])
  @@index([role, status])
  @@index([status])
}

model Venue {
  id              String            @id
  name            String            @unique
  capacity        Int
  location        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Invigilation    Invigilation[]
  VenueAssignment VenueAssignment[]
  VenueScan       VenueScan[]

  @@index([isActive])
}

model VenueAssignment {
  id                   String             @id
  examinationSessionId String
  venueId              String
  invigilatorId        String
  slotAt               DateTime
  createdAt            DateTime           @default(now())
  ExaminationSession   ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  User                 User               @relation(fields: [invigilatorId], references: [id], onDelete: Cascade)
  Venue                Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([examinationSessionId, venueId, slotAt, invigilatorId])
  @@index([examinationSessionId, venueId])
  @@index([examinationSessionId, venueId, slotAt])
  @@index([invigilatorId, examinationSessionId, slotAt])
  @@index([invigilatorId, slotAt])
}

model VenueScan {
  id                   String             @id
  venueId              String
  examinationSessionId String
  userId               String
  result               AttendanceResult
  scannedAt            DateTime           @default(now())
  ipAddress            String?
  userAgent            String?
  latitude             Float?
  locationAccuracy     Float?
  longitude            Float?
  locationAddress      String?
  ExaminationSession   ExaminationSession @relation(fields: [examinationSessionId], references: [id], onDelete: Cascade)
  User                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  Venue                Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([examinationSessionId, venueId])
  @@index([examinationSessionId, venueId, scannedAt])
  @@index([userId, scannedAt])
  @@index([venueId, scannedAt])
}

enum AttendanceResult {
  RECORDED
  REJECTED_WINDOW
  REJECTED_DUPLICATE
  REJECTED_UNASSIGNED
  REJECTED_INVALID_QR
  REJECTED_VENUE_MISMATCH
  ABSENT
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  DEPARTMENT_HEAD
  INVIGILATOR
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DISABLED
  REJECTED
}
