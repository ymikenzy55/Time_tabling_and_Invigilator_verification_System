# Base URL of the API, including the /api/v1 suffix.
# The Socket.IO origin is derived from this by stripping /api/v1.
# NOTE: Vite inlines this at BUILD time — changing it requires a rebuild,
# not just a restart. On Render, set it on the static site and redeploy.
# Production example: https://exam-management-server.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
